NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://agentops:agentops@localhost:55432/agentops
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9094
WORKFLOW_WORKER_METRICS_PORT=4101
AI_WORKER_METRICS_PORT=4102
TOOL_WORKER_METRICS_PORT=4103
NOTIFICATION_WORKER_METRICS_PORT=4104
OTEL_ENABLED=false
OTEL_DEPLOYMENT_ENVIRONMENT=local
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces

JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/auth/google/callback
ALERT_BOT_WEBHOOK_URL=
# shared Bearer token Alertmanager sends to /notifications/alertmanager; required outside APP_ENV=local
ALERTMANAGER_WEBHOOK_TOKEN=
OPENAI_API_KEY=
# Skip HUMAN_APPROVAL nodes; honoured only when APP_ENV=local. Keep false to review emails.
APP_ENV=local
# auto-create @agentops.local demo users on first login; defaults to on only when APP_ENV=local
DEMO_LOGIN_ENABLED=
# Optional role (OWNER|ADMIN|MEMBER|VIEWER) new users also get in ws_demo when it exists; prod overlay sets VIEWER.
DEMO_WORKSPACE_JOIN_ROLE=
WORKFLOW_AUTO_APPROVE=false
AI_DAILY_CALL_LIMIT=100
AI_DAILY_TOKEN_LIMIT=200000
GEMINI_API_KEY=

WEB_APP_URL=http://localhost:3000
API_URL=http://localhost:4000
# Requests per minute allowed per client; raise only for load tests.
API_RATE_LIMIT_PER_MINUTE=120
# Stricter per-minute limit for login/register/refresh to slow brute-force attempts.
AUTH_RATE_LIMIT_PER_MINUTE=10
# Domain for the API's HttpOnly session cookies. Leave empty for host-only cookies (fine when web and API share a host,
# e.g. localhost:3000 + localhost:4000). Set the parent domain (e.g. .example.com) when they are on sibling subdomains.
AUTH_COOKIE_DOMAIN=
# Number of reverse-proxy hops in front of the API (1 behind ingress-nginx); 0 locally.
API_TRUST_PROXY=0
NEXT_PUBLIC_API_URL=http://localhost:4000

# Web: show demo data when the API is unreachable (default off: pages show an error state).
NEXT_PUBLIC_DEMO_FALLBACK=false
