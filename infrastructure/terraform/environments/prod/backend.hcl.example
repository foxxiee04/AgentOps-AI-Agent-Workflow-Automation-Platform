# Copy this file to backend.hcl and replace the bucket placeholder with the
# globally unique state bucket created by the bootstrap stack, then initialize
# the backend with:
#
#   terraform init -backend-config=backend.hcl
#
bucket         = "agentops-terraform-state-REPLACE_ME"
key            = "agentops/prod/terraform.tfstate"
region         = "ap-southeast-1"
dynamodb_table = "agentops-terraform-locks"
encrypt        = true
