# Keys expected in the agentops-secrets Secret (synced by External Secrets in dev/prod).
# Local k3s without External Secrets: copy to secrets.env (ignored), fill in, then
#   kubectl -n agentops create secret generic agentops-secrets --from-env-file=secrets.env
DATABASE_URL=postgresql://agentops:REPLACE_ME@postgres:5432/agentops
POSTGRES_PASSWORD=REPLACE_ME
JWT_ACCESS_SECRET=REPLACE_ME
JWT_REFRESH_SECRET=REPLACE_ME
OPENAI_API_KEY=
ALERTMANAGER_WEBHOOK_TOKEN=REPLACE_ME
