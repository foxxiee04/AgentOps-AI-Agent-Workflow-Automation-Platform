      },
      "targets": [
        {
          "expr": "sum(rate(agentops_http_requests_total{job=\"agentops-api\",status_code=~\"5..\"}[5m])) / clamp_min(sum(rate(agentops_http_requests_total{job=\"agentops-api\"}[5m])), 1)",
          "legendFormat": "5xx ratio",
          "refId": "A"
        }
      ],
      "title": "API 5xx Ratio",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
