{
  "name": "@agentops/database",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm db:generate && tsc -p tsconfig.json",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:reset": "tsx scripts/db-reset.ts",
    "db:seed": "tsx scripts/seed-required.ts",
    "db:studio": "prisma studio --schema prisma/schema.prisma",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "pnpm db:generate && tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "typecheck": "pnpm db:generate && tsc -p tsconfig.json --noEmit",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:seed:demo": "tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "@agentops/shared": "workspace:*",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "dotenv": "^17.4.2",
    "prisma": "^7.10.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
