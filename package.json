{
  "name": "agentops-platform",
  "version": "0.1.0",
  "private": true,
  "description": "AI Agent workflow automation platform scaffold.",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "pnpm build:packages && turbo run dev --concurrency=13",
    "build:packages": "pnpm --filter @agentops/config --filter @agentops/database --filter @agentops/events --filter @agentops/observability --filter @agentops/shared --filter @agentops/ui build",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @agentops/database db:generate",
    "db:push": "pnpm --filter @agentops/database db:push",
    "db:studio": "pnpm --filter @agentops/database db:studio",
    "kafka:bootstrap": "pnpm --filter @agentops/events kafka:bootstrap",
    "compose:up": "docker compose up -d",
    "compose:down": "docker compose down",
    "docker:build:api": "docker build -f infrastructure/docker/api.Dockerfile -t agentops/api:local .",
    "docker:build:web": "docker build -f infrastructure/docker/web.Dockerfile -t agentops/web:local .",
    "docker:build:workflow-worker": "docker build -f infrastructure/docker/worker.Dockerfile --build-arg WORKER_PACKAGE=@agentops/workflow-worker --build-arg WORKER_MAIN=apps/workflow-worker/dist/main.js -t agentops/workflow-worker:local .",
    "docker:build:ai-worker": "docker build -f infrastructure/docker/worker.Dockerfile --build-arg WORKER_PACKAGE=@agentops/ai-worker --build-arg WORKER_MAIN=apps/ai-worker/dist/main.js -t agentops/ai-worker:local .",
    "docker:build:tool-worker": "docker build -f infrastructure/docker/worker.Dockerfile --build-arg WORKER_PACKAGE=@agentops/tool-worker --build-arg WORKER_MAIN=apps/tool-worker/dist/main.js -t agentops/tool-worker:local .",
    "docker:build:notification-worker": "docker build -f infrastructure/docker/worker.Dockerfile --build-arg WORKER_PACKAGE=@agentops/notification-worker --build-arg WORKER_MAIN=apps/notification-worker/dist/main.js -t agentops/notification-worker:local .",
    "docker:build:apps": "pnpm docker:build:api && pnpm docker:build:web && pnpm docker:build:workflow-worker && pnpm docker:build:ai-worker && pnpm docker:build:tool-worker && pnpm docker:build:notification-worker"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@vscode/ripgrep": "^1.18.0",
    "eslint": "^10.4.1",
    "prettier": "^3.8.3",
    "tsx": "^4.22.4",
    "turbo": "^2.5.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
