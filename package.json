{
  "name": "agentops-platform",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "AI Agent workflow automation platform scaffold.",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "pnpm build:packages && turbo run dev --concurrency=13",
    "dev:api": "pnpm build:packages && pnpm --filter @agentops/api dev",
    "dev:web": "pnpm build:packages && pnpm --filter @agentops/web dev",
    "dev:workers": "pnpm build:packages && turbo run dev --filter=@agentops/workflow-worker --filter=@agentops/ai-worker --filter=@agentops/tool-worker --filter=@agentops/notification-worker --concurrency=4",
    "eval:leads": "pnpm build:packages && pnpm --filter @agentops/ai-worker eval:leads --",
    "build:packages": "pnpm --filter @agentops/config --filter @agentops/database --filter @agentops/events --filter @agentops/observability --filter @agentops/shared --filter @agentops/ui build",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:api": "pnpm --filter @agentops/api test",
    "test:web": "pnpm --filter @agentops/web test",
    "test:workers": "pnpm --filter @agentops/workflow-worker --filter @agentops/ai-worker --filter @agentops/tool-worker --filter @agentops/notification-worker test",
    "test:e2e": "pnpm --filter @agentops/web test:e2e",
    "test:integration": "docker compose --profile test up -d --wait postgres-test kafka-test && pnpm build:packages && pnpm --filter @agentops/integration-tests test:integration",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "local:setup": "pnpm db:migrate:deploy && pnpm db:seed && pnpm db:seed:demo && pnpm kafka:bootstrap",
    "local:up": "pnpm compose:up && pnpm local:setup",
    "local:docker": "pnpm compose:apps:up",
    "db:generate": "pnpm --filter @agentops/database db:generate",
    "db:migrate": "pnpm --filter @agentops/database db:migrate",
    "db:migrate:deploy": "pnpm --filter @agentops/database db:migrate:deploy",
    "db:migrate:status": "pnpm --filter @agentops/database db:migrate:status",
    "db:seed": "pnpm --filter @agentops/database db:seed",
    "db:seed:demo": "pnpm --filter @agentops/database db:seed:demo",
    "db:reset": "pnpm --filter @agentops/database db:reset",
    "db:studio": "pnpm --filter @agentops/database db:studio",
    "kafka:bootstrap": "pnpm --filter @agentops/events kafka:bootstrap",
    "compose:up": "docker compose up -d",
    "compose:down": "docker compose down",
    "compose:apps:up": "node scripts/compose-apps.mjs up",
    "compose:apps:down": "node scripts/compose-apps.mjs down",
    "compose:apps:logs": "node scripts/compose-apps.mjs logs",
    "compose:apps:config": "node scripts/compose-apps.mjs config",
    "compose:apps:reset": "node scripts/compose-apps.mjs reset",
    "docker:build:api": "docker build -f infrastructure/docker/api.Dockerfile -t agentops/api:local .",
    "docker:build:web": "docker build -f infrastructure/docker/web.Dockerfile -t agentops/web:local .",
    "docker:build:workflow-worker": "docker build -f infrastructure/docker/worker.Dockerfile --build-arg WORKER_PACKAGE=@agentops/workflow-worker -t agentops/workflow-worker:local .",
    "docker:build:ai-worker": "docker build -f infrastructure/docker/worker.Dockerfile --build-arg WORKER_PACKAGE=@agentops/ai-worker -t agentops/ai-worker:local .",
    "docker:build:tool-worker": "docker build -f infrastructure/docker/worker.Dockerfile --build-arg WORKER_PACKAGE=@agentops/tool-worker -t agentops/tool-worker:local .",
    "docker:build:notification-worker": "docker build -f infrastructure/docker/worker.Dockerfile --build-arg WORKER_PACKAGE=@agentops/notification-worker -t agentops/notification-worker:local .",
    "docker:build:tools": "docker build -f infrastructure/docker/api.Dockerfile --target tools -t agentops/tools:local .",
    "load:leads": "node scripts/load-leads.mjs",
    "load:report": "node scripts/report-run-latency.mjs",
    "docker:lint": "node scripts/hadolint.mjs",
    "ci:lint": "node scripts/ci-lint.mjs",
    "docker:build:apps": "pnpm docker:build:api && pnpm docker:build:tools && pnpm docker:build:web && pnpm docker:build:workflow-worker && pnpm docker:build:ai-worker && pnpm docker:build:tool-worker && pnpm docker:build:notification-worker",
    "k8s:validate": "node infrastructure/k8s/validate.mjs",
    "tf:validate": "node infrastructure/terraform/validate.mjs"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@vscode/ripgrep": "^1.18.0",
    "eslint": "^10.4.1",
    "prettier": "^3.8.3",
    "tsx": "^4.22.4",
    "turbo": "^2.5.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
